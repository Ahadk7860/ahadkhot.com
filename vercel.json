{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "www.ahadkhot.com" }], "destination": "https://ahadkhot.com/", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.ahadkhot.com" }], "destination": "https://ahadkhot.com/:path*", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ]}
  ]
}
